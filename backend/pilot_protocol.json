{
  "id": "pilot_v1",
  "tolerance_sec": 5,
  "detectors": {
    "face_missing":   {"label": "Нүүр алга",        "events": ["face_missing"]},
    "multiple_faces": {"label": "Олон хүн",         "events": ["multiple_faces"]},
    "gaze":           {"label": "Харц",             "events": ["gaze_away"]},
    "object":         {"label": "Хориотой объект",  "events": ["object_detected", "looking_down_phone"]},
    "speech":         {"label": "Яриа",             "events": ["audio_speech", "audio_talking", "audio_multiple_voices"]},
    "whisper":        {"label": "Шивнээ",           "events": ["audio_whispering"]},
    "tab":            {"label": "Tab солих",        "events": ["tab_switch"]}
  },
  "steps": [
    {"id": "calibrate",   "category": "setup",  "duration": 10,
     "text": "Дэлгэц рүү хэвийн байрлалаар харна уу. Камер тохируулж байна."},
    {"id": "normal_1",    "category": "normal", "duration": 120,
     "text": "Хэвийн шалгалт өгнө үү: асуултаа чимээгүй уншиж, хариултаа бичнэ."},
    {"id": "look_left",   "category": "positive", "detector": "gaze", "duration": 10,
     "text": "Толгойгоо ЗҮҮН тийш эргүүлж, хана руу харна уу. (2 дохио сонсогдвол буцна)"},
    {"id": "normal_2",    "category": "normal", "duration": 30,
     "text": "Хэвийн үргэлжлүүлнэ үү."},
    {"id": "look_right",  "category": "positive", "detector": "gaze", "duration": 10,
     "text": "Толгойгоо БАРУУН тийш эргүүлж, хана руу харна уу."},
    {"id": "normal_3",    "category": "normal", "duration": 30,
     "text": "Хэвийн үргэлжлүүлнэ үү."},
    {"id": "write_paper", "category": "hard_negative", "duration": 20, "allow": ["looking_down"],
     "text": "Доош харж ширээн дээрх цаасан дээр бодлого бодож бичнэ үү (хэвийн үйлдэл)."},
    {"id": "phone",       "category": "positive", "detector": "object", "duration": 20,
     "allow": ["gaze_away", "looking_down"],
     "text": "Утсаа гаргаж, камерт харагдахаар барьж ашиглана уу."},
    {"id": "normal_4",    "category": "normal", "duration": 20,
     "text": "Утсаа хадгалаад хэвийн үргэлжлүүлнэ үү."},
    {"id": "phone_lap",   "category": "positive", "detector": "object", "duration": 20,
     "allow": ["gaze_away", "looking_down"],
     "text": "Утсаа ӨВӨР ДЭЭРЭЭ (ширээн доор) барьж, доош харж ашиглана уу."},
    {"id": "normal_5",    "category": "normal", "duration": 20,
     "text": "Утсаа хадгалаад хэвийн үргэлжлүүлнэ үү."},
    {"id": "book",        "category": "positive", "detector": "object", "duration": 15,
     "allow": ["gaze_away", "looking_down"],
     "text": "Ном (эсвэл дэвтэр) нээж камерт харагдахаар уншина уу."},
    {"id": "leave",       "category": "positive", "detector": "face_missing", "duration": 15,
     "allow": ["gaze_away", "looking_down", "multiple_faces"],
     "text": "Сандлаасаа босоод камерын харагдах хүрээнээс гарна уу. (2 дохио сонсогдвол буцаж сууна)"},
    {"id": "normal_6",    "category": "normal", "duration": 20,
     "text": "Буцаж суугаад хэвийн үргэлжлүүлнэ үү."},
    {"id": "second_person", "category": "positive", "detector": "multiple_faces", "duration": 15, "helper": true,
     "allow": ["gaze_away"],
     "text": "Туслах хүн таны ард/хажууд камерт харагдахаар зогсоно."},
    {"id": "normal_7",    "category": "normal", "duration": 20,
     "text": "Туслах хүн гарна. Хэвийн үргэлжлүүлнэ үү."},
    {"id": "talk",        "category": "positive", "detector": "speech", "duration": 20, "helper": true,
     "allow": ["gaze_away", "audio_short_speech", "multiple_faces"],
     "text": "Туслах хүнтэй (эсвэл утсаар) хэвийн дуугаар ярилцана уу."},
    {"id": "normal_8",    "category": "normal", "duration": 20,
     "text": "Ярихаа болиод хэвийн үргэлжлүүлнэ үү."},
    {"id": "whisper",     "category": "positive", "detector": "whisper", "duration": 20,
     "allow": ["audio_short_speech", "gaze_away"],
     "text": "Дэлгэц рүү харсаар, хариултаа өөртөө ШИВНЭЖ уншина уу."},
    {"id": "normal_9",    "category": "normal", "duration": 20,
     "text": "Хэвийн үргэлжлүүлнэ үү."},
    {"id": "read_aloud",  "category": "hard_negative", "duration": 15,
     "text": "Асуултыг ердийн дуугаар чанга уншина уу (зөвшөөрөгдөх эсэх нь бодлогын асуудал)."},
    {"id": "typing",      "category": "hard_negative", "duration": 20,
     "text": "Хариултаа гараар хурдан, чимээтэй бичнэ үү."},
    {"id": "tab",         "category": "positive", "detector": "tab", "duration": 10,
     "allow": ["fullscreen_exit", "focus_lost"],
     "text": "Өөр tab/цонх руу шилжээд, 2 дохио сонсогдвол буцаж ирнэ үү."},
    {"id": "normal_10",   "category": "normal", "duration": 30,
     "text": "Хэвийн үргэлжлүүлнэ үү. Удахгүй туршилт дуусна."}
  ]
}
